# ===============================
# Exemple de Makefile portable
# Projet : OceanDepths
# À copier et adapter selon votre système
# ===============================

# --- Configuration générale ---
# Compilateur (gcc ou clang)
CC = gcc

# Options de compilation
CFLAGS = -Wall -Wextra -std=c11 -g

# Nom de l'exécutable
TARGET = projet_oceandepths

# Dossier du code source
SRC_DIR = src

# Liste des fichiers sources (.c)
# Sur Windows PowerShell / CMD, "dir /B /S src\*.c" peut remplacer find
SOURCES := $(shell find $(SRC_DIR) -name '*.c' 2> NUL || dir /B /S $(SRC_DIR)\*.c)

# --- Commandes selon le système ---
# Sur Linux/macOS : rm
# Sur Windows : del
RM = rm -f

# --- Compilation ---
all: $(TARGET)

$(TARGET): $(SOURCES)
	$(CC) $(CFLAGS) $(SOURCES) -o $(TARGET)

# --- Exécution ---
run: $(TARGET)
	./$(TARGET)

# --- Nettoyage ---
clean:
	$(RM) $(TARGET)
	# Pour macOS : supprimer les fichiers .dSYM
	find . -name "*.dSYM" -type d -exec rm -rf {} + 2> NUL || (if exist *.dSYM rmdir /S /Q *.dSYM)

# --- Informations utiles ---
# - Sous macOS/Linux : utilisez "make run" pour compiler et exécuter.
# - Sous Windows : utilisez Git Bash ou WSL (Linux) pour plus de compatibilité.
# - Si vous utilisez CMD/PowerShell, adaptez les lignes avec rm/del.
# ===============================